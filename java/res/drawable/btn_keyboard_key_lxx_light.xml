<?xml version="1.0" encoding="utf-8"?>
<!-- KiroOS 2.1 keyboard keys: a press lights the key at once and it fades back softly -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="30" android:exitFadeDuration="200">
    <!-- Action keys. -->
    <item android:state_active="true" android:state_pressed="true"
          android:drawable="@drawable/kiroos_light_key_action_pressed" />
    <item android:state_active="true"
          android:drawable="@drawable/kiroos_light_key_action" />

    <!-- Toggle keys (shift / caps lock) -->
    <item android:state_checkable="true" android:state_checked="true" android:state_pressed="true"
          android:drawable="@drawable/kiroos_light_key_sticky_on_pressed" />
    <item android:state_checkable="true" android:state_pressed="true"
          android:drawable="@drawable/kiroos_light_key_functional_pressed" />
    <item android:state_checkable="true" android:state_checked="true"
          android:drawable="@drawable/kiroos_light_key_sticky_on" />
    <item android:state_checkable="true"
          android:drawable="@drawable/kiroos_light_key_functional" />

    <!-- Empty background keys. -->
    <item android:state_empty="true" android:state_pressed="true"
          android:drawable="@drawable/kiroos_light_key_pressed" />
    <item android:state_empty="true"
          android:drawable="@android:color/transparent" />

    <!-- Normal keys. -->
    <item android:state_pressed="true"
          android:drawable="@drawable/kiroos_light_key_pressed" />
    <item android:drawable="@drawable/kiroos_light_key_normal" />
</selector>
